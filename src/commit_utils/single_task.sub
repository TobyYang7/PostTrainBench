executable = /bin/bash
num_gpus = 1
cuda_device_idx =
condor_log_dir = .
gpu_requirements = TARGET.CUDADeviceName == "NVIDIA H100 80GB HBM3"
machine_requirements = Machine != "i104.internal.cluster.is.localnet"
arguments = src/run_task.sh $(eval) $(agent) $(model_to_train) $(Cluster) $(num_hours) $(agent_config) $(num_gpus) $(cuda_device_idx)
environment = "OPENAI_API_KEY=$ENV(OPENAI_API_KEY) ANTHROPIC_API_KEY=$ENV(ANTHROPIC_API_KEY) GEMINI_API_KEY=$ENV(GEMINI_API_KEY) OPENCODE_API_KEY=$ENV(OPENCODE_API_KEY) DASHSCOPE_API_KEY=$ENV(DASHSCOPE_API_KEY) ZAI_API_KEY=$ENV(ZAI_API_KEY) HOME=$ENV(HOME) POST_TRAIN_BENCH_RESULTS_DIR=$ENV(POST_TRAIN_BENCH_RESULTS_DIR) POST_TRAIN_BENCH_CONTAINERS_DIR=$ENV(POST_TRAIN_BENCH_CONTAINERS_DIR) POST_TRAIN_BENCH_CONTAINER_NAME=$ENV(POST_TRAIN_BENCH_CONTAINER_NAME) POST_TRAIN_BENCH_JOB_SCHEDULER=$ENV(POST_TRAIN_BENCH_JOB_SCHEDULER) POST_TRAIN_BENCH_EXPERIMENT_NAME=$ENV(POST_TRAIN_BENCH_EXPERIMENT_NAME) HF_HOME=$ENV(HF_HOME) POST_TRAIN_BENCH_PROMPT=$ENV(POST_TRAIN_BENCH_PROMPT) POST_TRAIN_BENCH_JUDGE_PROMPT=$ENV(POST_TRAIN_BENCH_JUDGE_PROMPT) POST_TRAIN_BENCH_JUDGE_MODEL=$ENV(POST_TRAIN_BENCH_JUDGE_MODEL) POST_TRAIN_BENCH_REQUIRED_GPU_NAME=$ENV(POST_TRAIN_BENCH_REQUIRED_GPU_NAME) POST_TRAIN_BENCH_COPY_HOST_CODEX_AUTH=$ENV(POST_TRAIN_BENCH_COPY_HOST_CODEX_AUTH) POST_TRAIN_BENCH_INSTALL_HOST_CODEX_BINARY=$ENV(POST_TRAIN_BENCH_INSTALL_HOST_CODEX_BINARY) POST_TRAIN_BENCH_CODEX_BIN=$ENV(POST_TRAIN_BENCH_CODEX_BIN)"
error = $(condor_log_dir)/test_$(Cluster).err
output = $(condor_log_dir)/test_$(Cluster).out
log = $(condor_log_dir)/test_$(Cluster).log
request_memory = 131072
request_cpus = 16
request_gpus = $(num_gpus)
requirements = ($(gpu_requirements)) && ($(machine_requirements))
request_disk=400G
+BypassLXCfs="true"
queue
