# Copy this to .htcondor-submit/env and fill in the values for your pool.

# Required: HTCondor central manager for the existing GPU pool.
CONDOR_HOST=cm.example.org
# CONDOR_SERVICE_HOST=cm.example.org

# Token auth is preferred. Put token files in .htcondor-submit/tokens/.
USE_POOL_PASSWORD=no

# If your site uses pool-password auth, set USE_POOL_PASSWORD=yes and put
# password files in .htcondor-submit/passwords/.

# Optional: if your site has a condor_submit_bid helper with bid pricing, map
# the numeric bid to your site's condor_submit -append expression.
# Example:
# CONDOR_SUBMIT_BID_APPEND=+MaxRunningPrice={bid}
CONDOR_SUBMIT_BID_APPEND=

# Optional image/container names.
POST_TRAIN_BENCH_HTCONDOR_IMAGE=posttrainbench-htcondor-submit
POST_TRAIN_BENCH_HTCONDOR_CONTAINER=ptb-htcondor-submit

# Optional: override the upstream HTCondor submit image used at build time.
# The HTCondor docs document lts as the stable tag; latest tracks newest builds.
HTCONDOR_SUBMIT_IMAGE=htcondor/submit:lts
